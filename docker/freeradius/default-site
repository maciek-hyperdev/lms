server default {
    listen {
        type = auth
        ipaddr = *
        port = 0
    }

    listen {
        type = acct
        ipaddr = *
        port = 0
    }

    authorize {
        filter_username
        preprocess

        # PPPoE auth: check login/password, return IP + rate limit
        sql-lms-pppoe

        # Set Auth-Type based on password attribute found
        pap
        chap
        mschap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
    }

    preacct {
        preprocess
        acct_unique
    }

    accounting {
        sql-lms
    }

    post-auth {
        sql-lms-lastonline

        Post-Auth-Type REJECT {
            attr_filter.access_reject
        }
    }
}
